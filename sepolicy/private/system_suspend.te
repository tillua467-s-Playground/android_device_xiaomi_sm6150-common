# /sys/class/wakeup/* are symlinks to per-device wakeupN directories created
# by drivers/base/power/wakeup_stats.c under the owning device.  Those paths
# are generic sysfs, so r_dir_file(system_suspend, sysfs_wakeup) in
# system/sepolicy does not cover them and the suspend stats read is denied.
#
# Relabelling every device path is not expressible with a generic genfscon,
# so allow the daemon to read them.  Read only - no write, no generic wildcard.
# (device/xiaomi/sm8250-common does the same for the directory case.)
allow system_suspend sysfs:dir { read open search };

# NOTE: a file rule is NOT possible here.  The wakeup stats files are generic
# sysfs, and system/sepolicy/private/coredomain.te:144 neverallows coredomain
# from reading sysfs:file:
#   neverallow { coredomain ... } sysfs:file { ... read ... }
# Fixing those reads properly requires relabelling the per-device wakeupN
# directories, which is not expressible as a generic genfscon.  The residual
# system_suspend sysfs:file denials are therefore expected and harmless.
